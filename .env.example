# HP Group Hub — variáveis de ambiente (copie para .env.local; NUNCA commitar valores reais de segredo)

# --- Front-end (públicas por design; protegidas por RLS) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_APP_ENV=development            # development | preview | production

# --- Somente servidor (Netlify Functions). NUNCA prefixar com VITE_ ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # chave privilegiada: só no painel da Netlify / .env.local do servidor

# --- E-mail transacional (somente servidor / Functions). Resend com domínio próprio do HP Group ---
RESEND_API_KEY=
EMAIL_FROM=
